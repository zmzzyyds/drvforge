# Normalize line endings: kernel Makefiles and shell scripts require LF.
* text=auto eol=lf

*.jinja text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
Makefile text eol=lf
*.dts text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.toml text eol=lf
LICENSE text eol=lf

# Binary assets (if assets are added later)
*.png binary
*.jpg binary
*.ico binary
