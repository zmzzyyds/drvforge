/*
 * {{ module_name }}.c - I2C temperature sensor driver (IIO + regmap)
 *
 * Generated by drvforge.
 *
 * Reference driver for a TMP100/TMP102-style 12-bit temperature sensor:
 *
 *   Register 0x00: temperature MSB
 *   Register 0x01: temperature LSB (upper 4 bits used), 1 LSB = 1/16 degC
 *
 * The driver registers an IIO temperature channel exposing
 * in_temp_raw and in_temp_scale, so standard tools (libiio, iio_info,
 * sysfs) work without custom userspace code.
 *
 * Replace the register map and conversion with your silicon's values when
 * bringing up real hardware.
 *
 * Copyright (C) {{ year }} {{ author }} <{{ email }}>
 */

#include <linux/bitops.h>
#include <linux/i2c.h>
#include <linux/iio/iio.h>
#include <linux/module.h>
#include <linux/mod_devicetable.h>
#include <linux/regmap.h>

#define {{ name_upper }}_REG_TEMP_MSB	0x00
#define {{ name_upper }}_REG_TEMP_LSB	0x01

/* 12-bit result, left-aligned in 16 bits, 1 LSB = 1/16 degree Celsius. */
#define {{ name_upper }}_RES_SHIFT	4
#define {{ name_upper }}_SIGN_BIT	11

struct {{ module_name }}_data {
	struct regmap *regmap;
};

static int {{ module_name }}_read_raw(struct iio_dev *indio_dev,
				      struct iio_chan_spec const *chan,
				      int *val, int *val2, long mask)
{
	struct {{ module_name }}_data *priv = iio_priv(indio_dev);
	u8 buf[2];
	u16 raw16;
	int raw;
	int ret;

	switch (mask) {
	case IIO_CHAN_INFO_RAW:
		ret = regmap_bulk_read(priv->regmap,
				       {{ name_upper }}_REG_TEMP_MSB, buf,
				       sizeof(buf));
		if (ret)
			return ret;

		raw16 = ((u16)buf[0] << 8) | buf[1];
		raw = sign_extend32(raw16 >> {{ name_upper }}_RES_SHIFT,
				    {{ name_upper }}_SIGN_BIT);
		*val = raw;
		return IIO_VAL_INT;

	case IIO_CHAN_INFO_SCALE:
		/* 1/16 degree Celsius per LSB. */
		*val = 1;
		*val2 = 16;
		return IIO_VAL_FRACTIONAL;

	default:
		return -EINVAL;
	}
}

static const struct iio_info {{ module_name }}_info = {
	.read_raw = {{ module_name }}_read_raw,
};

static const struct iio_chan_spec {{ module_name }}_channels[] = {
	{
		.type = IIO_TEMP,
		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW) |
				      BIT(IIO_CHAN_INFO_SCALE),
	},
};

static const struct regmap_config {{ module_name }}_regmap_config = {
	.reg_bits = 8,
	.val_bits = 8,
	.max_register = {{ name_upper }}_REG_TEMP_LSB,
};

static int {{ module_name }}_probe(struct i2c_client *client)
{
	struct device *dev = &client->dev;
	struct {{ module_name }}_data *priv;
	struct iio_dev *indio_dev;
	struct regmap *regmap;

	indio_dev = devm_iio_device_alloc(dev, sizeof(*priv));
	if (!indio_dev)
		return -ENOMEM;

	regmap = devm_regmap_init_i2c(client, &{{ module_name }}_regmap_config);
	if (IS_ERR(regmap))
		return dev_err_probe(dev, PTR_ERR(regmap),
				     "failed to init regmap\n");

	priv = iio_priv(indio_dev);
	priv->regmap = regmap;

	indio_dev->name = "{{ module_name }}";
	indio_dev->modes = INDIO_DIRECT_MODE;
	indio_dev->info = &{{ module_name }}_info;
	indio_dev->channels = {{ module_name }}_channels;
	indio_dev->num_channels = ARRAY_SIZE({{ module_name }}_channels);

	return devm_iio_device_register(dev, indio_dev);
}

static const struct of_device_id {{ module_name }}_of_match[] = {
	{ .compatible = "{{ compat }}" },
	{ }
};
MODULE_DEVICE_TABLE(of, {{ module_name }}_of_match);

static const struct i2c_device_id {{ module_name }}_id[] = {
	{ "{{ driver_name }}", 0 },
	{ }
};
MODULE_DEVICE_TABLE(i2c, {{ module_name }}_id);

static struct i2c_driver {{ module_name }}_driver = {
	.driver = {
		.name = "{{ module_name }}",
		.of_match_table = {{ module_name }}_of_match,
	},
	.probe = {{ module_name }}_probe,
	.id_table = {{ module_name }}_id,
};
module_i2c_driver({{ module_name }}_driver);

MODULE_AUTHOR("{{ author }} <{{ email }}>");
MODULE_DESCRIPTION("drvforge IIO temperature sensor driver ({{ compat }})");
MODULE_LICENSE("GPL v2");
