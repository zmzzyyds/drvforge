/*
 * Userspace test client for /dev/{{ module_name }}.
 *
 * Verifies the write/read echo semantics of the char device and reads the
 * matching value back through the sysfs "message" attribute.
 *
 * Exit code 0 = all checks passed, 1 = a check failed.
 */

#include <errno.h>
#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#define DEV_PATH	"/dev/{{ module_name }}"
#define SYSFS_PATH	"/sys/class/misc/{{ module_name }}/message"
#define PAYLOAD		"drvforge-hello"

static int check_sysfs(const char *expected)
{
	FILE *f = fopen(SYSFS_PATH, "r");
	char line[128];
	size_t len;

	if (!f) {
		perror("fopen " SYSFS_PATH);
		return 1;
	}
	if (!fgets(line, sizeof(line), f)) {
		perror("fgets sysfs");
		fclose(f);
		return 1;
	}
	fclose(f);

	/* sysfs adds a trailing newline; compare up to payload length. */
	len = strlen(expected);
	if (strncmp(line, expected, len) != 0) {
		fprintf(stderr, "sysfs mismatch: got %.*s, want %s\n",
			(int)sizeof(line), line, expected);
		return 1;
	}
	printf("[ok] sysfs %s reports %s", SYSFS_PATH, line);
	return 0;
}

int main(void)
{
	char buf[128] = {0};
	ssize_t n;
	int fd;
	int rc = 1;

	fd = open(DEV_PATH, O_RDWR);
	if (fd < 0) {
		perror("open " DEV_PATH);
		return 1;
	}

	n = write(fd, PAYLOAD, strlen(PAYLOAD));
	if (n != (ssize_t)strlen(PAYLOAD)) {
		perror("write");
		goto out;
	}
	printf("[ok] wrote %zd bytes ('%s')\n", n, PAYLOAD);

	if (lseek(fd, 0, SEEK_SET) < 0) {
		perror("lseek");
		goto out;
	}

	n = read(fd, buf, sizeof(buf) - 1);
	if (n < 0) {
		perror("read");
		goto out;
	}
	buf[n] = '\0';
	if (strcmp(buf, PAYLOAD) != 0) {
		fprintf(stderr, "echo mismatch: got '%s', want '%s'\n", buf,
			PAYLOAD);
		goto out;
	}
	printf("[ok] read back '%s'\n", buf);

	if (check_sysfs(PAYLOAD) != 0)
		goto out;

	printf("PASS: all {{ module_name }} checks succeeded\n");
	rc = 0;
out:
	close(fd);
	return rc;
}
