config {{ name_upper }}
	tristate "{{ driver_name }} misc platform device support"
	depends on OF
	help
	  Say M (or Y) here to enable the {{ driver_name }} misc platform
	  driver. It binds to Device Tree nodes with the compatible string
	  "{{ compat }}" and exposes /dev/{{ module_name }} plus a
	  "message" sysfs attribute.

	  To compile this driver as a module, choose M here: the module will
	  be called {{ module_name }}.
