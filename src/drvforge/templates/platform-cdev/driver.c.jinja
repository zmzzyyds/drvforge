#include "{{ module_name }}.h"

/**
 * struct {{ module_name }}_data - per-device private data
 * @devt: allocated device number region
 * @cdev: registered character device
 * @class: device class for /dev node creation
 * @device: created device node
 * @lock: serialises ioctl access to device state
 * @gain: configurable gain
 * @resets: reset counter
 */
struct {{ module_name }}_data {
	dev_t devt;
	struct cdev cdev;
	struct class *class;
	struct device *device;
	struct mutex lock;
	u32 gain;
	u32 resets;
};

static int {{ module_name }}_open(struct inode *inode, struct file *filp)
{
	struct {{ module_name }}_data *priv;

	priv = container_of(inode->i_cdev, struct {{ module_name }}_data, cdev);
	filp->private_data = priv;
	return 0;
}

static long {{ module_name }}_ioctl(struct file *filp, unsigned int cmd,
				   unsigned long arg)
{
	struct {{ module_name }}_data *priv = filp->private_data;
	struct {{ module_name }}_info info;
	u32 value;
	int ret = 0;

	/* Reject commands belonging to another driver. Unknown command
	 * numbers and wrong direction/size encodings fall through to the
	 * default case below and return -ENOTTY as well.
	 */
	if (_IOC_TYPE(cmd) != {{ name_upper }}_IOC_MAGIC)
		return -ENOTTY;

	mutex_lock(&priv->lock);
	switch (cmd) {
	case {{ name_upper }}_IOCG_INFO:
		memset(&info, 0, sizeof(info));
		info.gain = priv->gain;
		info.resets = priv->resets;
		if (copy_to_user((void __user *)arg, &info, sizeof(info)))
			ret = -EFAULT;
		break;

	case {{ name_upper }}_IOCS_GAIN:
		if (copy_from_user(&value, (void __user *)arg, sizeof(value))) {
			ret = -EFAULT;
			break;
		}
		if (value > {{ name_upper }}_GAIN_MAX) {
			ret = -EINVAL;
			break;
		}
		priv->gain = value;
		break;

	case {{ name_upper }}_IOC_RESET:
		priv->gain = {{ name_upper }}_GAIN_DEFAULT;
		priv->resets++;
		break;

	default:
		ret = -ENOTTY;
	}
	mutex_unlock(&priv->lock);
	return ret;
}

static const struct file_operations {{ module_name }}_fops = {
	.owner = THIS_MODULE,
	.open = {{ module_name }}_open,
	.unlocked_ioctl = {{ module_name }}_ioctl,
	.compat_ioctl = {{ module_name }}_ioctl,
	/* no_llseek() was removed in 6.12; a NULL llseek fails with ESPIPE. */
#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 12, 0)
	.llseek = no_llseek,
#endif
};

static int {{ module_name }}_probe(struct platform_device *pdev)
{
	struct device *dev = &pdev->dev;
	struct {{ module_name }}_data *priv;
	int ret;

	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
	if (!priv)
		return -ENOMEM;

	mutex_init(&priv->lock);
	priv->gain = {{ name_upper }}_GAIN_DEFAULT;
	platform_set_drvdata(pdev, priv);

	ret = alloc_chrdev_region(&priv->devt, 0, 1, "{{ module_name }}");
	if (ret)
		return dev_err_probe(dev, ret, "failed to allocate device numbers\n");

	cdev_init(&priv->cdev, &{{ module_name }}_fops);
	priv->cdev.owner = THIS_MODULE;
	ret = cdev_add(&priv->cdev, priv->devt, 1);
	if (ret) {
		dev_err(dev, "cdev_add failed: %d\n", ret);
		goto err_unregister_region;
	}

#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 4, 0)
	priv->class = class_create("{{ module_name }}");
#else
	priv->class = class_create(THIS_MODULE, "{{ module_name }}");
#endif
	if (IS_ERR(priv->class)) {
		ret = PTR_ERR(priv->class);
		goto err_cdev_del;
	}

	priv->device = device_create(priv->class, dev, priv->devt, NULL,
				     "{{ module_name }}");
	if (IS_ERR(priv->device)) {
		ret = PTR_ERR(priv->device);
		goto err_class_destroy;
	}

	dev_info(dev, "registered /dev/{{ module_name }} at %d:%d\n",
		 MAJOR(priv->devt), MINOR(priv->devt));
	return 0;

err_class_destroy:
	class_destroy(priv->class);
err_cdev_del:
	cdev_del(&priv->cdev);
err_unregister_region:
	unregister_chrdev_region(priv->devt, 1);
	return ret;
}

static void {{ module_name }}_remove(struct platform_device *pdev)
{
	struct {{ module_name }}_data *priv = platform_get_drvdata(pdev);

	device_destroy(priv->class, priv->devt);
	class_destroy(priv->class);
	cdev_del(&priv->cdev);
	unregister_chrdev_region(priv->devt, 1);
}

